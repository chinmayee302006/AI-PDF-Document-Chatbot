{
  "name": "ai-pdf-chatbot-langchain",
  "description": "AI PDF Chatbot template based on Learning LangChain",
  "private": true,
  "packageManager": "yarn@1.22.19",
  "version": "0.0.1",
  "author": "Nayjo Osthi",
  "license": "MIT",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "yarn run turbocommand build",
    "turbocommand": "yarn turbo",
    "lint": "yarn run turbocommand lint",
    "lint:fix": "yarn run turbocommand lint:fix",
    "format": "yarn run turbocommand format",
    "format:check": "yarn run turbocommand format:check"
  },
  "devDependencies": {
    "turbo": "latest"
  }
}
